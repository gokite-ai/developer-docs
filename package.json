{
  "name": "kite-docs",
  "version": "1.0.0",
  "description": "Kite Documentation - The first AI payment blockchain. Foundational infrastructure empowering autonomous agents to operate and transact with identity, payment, governance, and verification.",
  "main": "book.json",
  "scripts": {
    "serve": "gitbook serve",
    "build": "gitbook build",
    "install": "gitbook install",
    "pdf": "gitbook pdf . _book/kite-docs.pdf",
    "epub": "gitbook epub . _book/kite-docs.epub",
    "mobi": "gitbook mobi . _book/kite-docs.mobi",
    "build:changelog": "node scripts/build-changelog.mjs",
    "test:changelog": "vitest run scripts/build-changelog.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gokite-ai/kite-docs.git"
  },
  "keywords": [
    "kite",
    "blockchain",
    "ai",
    "payments",
    "documentation",
    "gitbook"
  ],
  "author": "Kite Team",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/gokite-ai/kite-docs/issues"
  },
  "homepage": "https://github.com/gokite-ai/kite-docs#readme",
  "devDependencies": {
    "ajv": "^8.12.0",
    "ajv-formats": "^2.1.1",
    "gitbook-cli": "^2.3.2",
    "gray-matter": "^4.0.3",
    "vitest": "^1.4.0"
  },
  "dependencies": {
    "js-yaml": "^4.1.1"
  }
}
